@page "/"
@rendermode InteractiveServer
@inject ConfigurationService ConfigSvc
@inject VacationWorker Worker
@inject HomeAssistantClient HaClient

<PageTitle>HaVacation – Configuration</PageTitle>

<h1>Vacation Mode Configuration</h1>

@if (_successMessage is not null)
{
    <div class="alert alert-success" role="alert">@_successMessage</div>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-error" role="alert">@_errorMessage</div>
}

<div class="card">
    <div class="card-header">
        <h2>Vacation Mode</h2>
        <span class="badge @(_vacation.Enabled ? "badge-active" : "badge-inactive")">
            @(_vacation.Enabled ? "Active" : "Inactive")
        </span>
    </div>
    <p>Enable vacation mode to replay your home's historical activity patterns, making the house look occupied.</p>
    <label class="toggle-label">
        <input class="toggle-input" type="checkbox" @bind="_vacation.Enabled" />
        <span class="toggle-track"><span class="toggle-thumb"></span></span>
        <span>@(_vacation.Enabled ? "Vacation mode is ON" : "Vacation mode is OFF")</span>
    </label>
</div>

<div class="card">
    <div class="card-header"><h2>Home Assistant Connection</h2></div>
    <div class="form-group">
        <label for="ha-url">Instance URL</label>
        <input id="ha-url" type="url" class="form-control" placeholder="Leave empty in Home Assistant add-on mode" @bind="_ha.Url" />
        <span class="hint">When installed as an add-on, leave this empty to use the Supervisor API automatically.</span>
    </div>
    <div class="form-group">
        <label for="ha-token">Long-Lived Access Token</label>
        <input id="ha-token" type="password" class="form-control" placeholder="Only needed for standalone Docker" @bind="_ha.Token" />
        <span class="hint">Not required when HaVacation runs as a Home Assistant add-on.</span>
    </div>
</div>

<div class="card">
    <div class="card-header"><h2>Replay Settings</h2></div>
    <div class="form-row">
        <div class="form-group">
            <label for="lookback">Lookback Days</label>
            <input id="lookback" type="number" class="form-control form-control-sm" min="1" max="365" @bind="_vacation.LookbackDays" />
            <span class="hint">Days back to use as the reference pattern (7 = same weekday).</span>
        </div>
        <div class="form-group">
            <label for="jitter">Random Jitter (seconds)</label>
            <input id="jitter" type="number" class="form-control form-control-sm" min="0" max="3600" @bind="_vacation.RandomJitterSeconds" />
            <span class="hint">Each event is shifted by a random offset (±N seconds).</span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h2>Included Entities</h2></div>
    <p>Select the Home Assistant entities whose historical activity may be replayed.</p>

    @for (var i = 0; i < _vacation.Entities.Count; i++)
    {
        var index = i;
        <div class="entity-row" @key="(_vacation.Entities[index], index)">
            <input type="text" class="form-control" value="@_vacation.Entities[index]" placeholder="e.g. light.living_room"
                   @onchange="e => UpdateEntity(index, e.Value?.ToString() ?? string.Empty)" />
            <button class="btn btn-remove" type="button" @onclick="() => RemoveEntity(index)">✕</button>
        </div>
    }

    <div class="entity-row entity-add-row">
        <input type="text" class="form-control" placeholder="Add entity ID, e.g. light.bedroom" @bind="_newEntityId" @onkeydown="OnNewEntityKeyDown" />
        <button class="btn btn-add" type="button" @onclick="AddEntity">+ Add</button>
    </div>

    <div class="entity-picker-section">
        <button class="btn btn-secondary" type="button" @onclick="TogglePickerAsync" disabled="@_pickerLoading">
            @if (_pickerLoading) { <span>Loading entities…</span> }
            else if (_showPicker) { <span>▲ Hide entity browser</span> }
            else { <span>🔍 Browse HA entities</span> }
        </button>

        @if (_showPicker)
        {
            <div class="entity-picker">
                <div class="entity-picker-header">
                    <input type="search" class="form-control" placeholder="Filter by ID or name…" @bind="_pickerFilter" @bind:event="oninput" />
                    <button class="btn btn-remove" type="button" @onclick="ClosePicker">✕</button>
                </div>
                @if (_pickerError is not null)
                {
                    <div class="alert alert-error" style="margin:.5rem 0">@_pickerError</div>
                }
                else
                {
                    var filtered = FilteredPickerEntities;
                    @if (filtered.Count == 0)
                    {
                        <p class="picker-empty">No matching entities found.</p>
                    }
                    else
                    {
                        <ul class="picker-list">
                            @foreach (var entity in filtered)
                            {
                                var alreadyAdded = _vacation.Entities.Contains(entity.EntityId);
                                <li class="picker-item @(alreadyAdded ? "picker-item-added" : "")" @key="entity.EntityId">
                                    <div class="picker-item-info">
                                        <span class="picker-entity-id">@entity.EntityId</span>
                                        @if (entity.FriendlyName != entity.EntityId)
                                        {
                                            <span class="picker-friendly-name">@entity.FriendlyName</span>
                                        }
                                    </div>
                                    @if (alreadyAdded)
                                    {
                                        <button class="btn btn-remove btn-sm" type="button" @onclick="() => RemoveEntityById(entity.EntityId)">✕</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-add btn-sm" type="button" @onclick="() => AddEntityFromPicker(entity.EntityId)">+ Add</button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header"><h2>Exclusions</h2></div>
    <p>Excluded entities are never replayed, even if they are present in the included list.</p>

    <h3>Exact entities</h3>
    @for (var i = 0; i < _vacation.ExcludedEntities.Count; i++)
    {
        var index = i;
        <div class="entity-row" @key="($"excluded-{index}")">
            <input type="text" class="form-control" value="@_vacation.ExcludedEntities[index]"
                   @onchange="e => _vacation.ExcludedEntities[index] = e.Value?.ToString() ?? string.Empty" />
            <button class="btn btn-remove" type="button" @onclick="() => _vacation.ExcludedEntities.RemoveAt(index)">✕</button>
        </div>
    }
    <div class="entity-row entity-add-row">
        <input type="text" class="form-control" placeholder="e.g. switch.fridge" @bind="_newExcludedEntity" />
        <button class="btn btn-add" type="button" @onclick="AddExcludedEntity">+ Exclude</button>
    </div>

    <h3>Patterns</h3>
    <p class="hint">Use <code>*</code> for any sequence and <code>?</code> for one character, e.g. <code>media_player.*</code> or <code>switch.fridge_*</code>.</p>
    @for (var i = 0; i < _vacation.ExcludedPatterns.Count; i++)
    {
        var index = i;
        <div class="entity-row" @key="($"pattern-{index}")">
            <input type="text" class="form-control" value="@_vacation.ExcludedPatterns[index]"
                   @onchange="e => _vacation.ExcludedPatterns[index] = e.Value?.ToString() ?? string.Empty" />
            <button class="btn btn-remove" type="button" @onclick="() => _vacation.ExcludedPatterns.RemoveAt(index)">✕</button>
        </div>
    }
    <div class="entity-row entity-add-row">
        <input type="text" class="form-control" placeholder="e.g. media_player.*" @bind="_newExcludedPattern" />
        <button class="btn btn-add" type="button" @onclick="AddExcludedPattern">+ Exclude pattern</button>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2>Preview / Dry Run</h2>
        <button class="btn btn-secondary" type="button" @onclick="PreviewAsync" disabled="@_previewLoading">
            @(_previewLoading ? "Building preview…" : "▶ Preview today")
        </button>
    </div>
    <p>Shows exactly what HaVacation would still do today with the current form values. Nothing is executed and you do not need to save or enable Vacation Mode first.</p>

    @if (_preview is not null)
    {
        <p><strong>@_preview.Count</strong> upcoming event@(_preview.Count == 1 ? "" : "s") after exclusions and jitter.</p>
        @if (_preview.Count == 0)
        {
            <div class="schedule-empty">No events would be replayed for the rest of today.</div>
        }
        else
        {
            <div class="schedule-table-wrap">
                <table class="schedule-table">
                    <thead><tr><th>Time</th><th>Entity</th><th>Action</th></tr></thead>
                    <tbody>
                    @foreach (var ev in _preview)
                    {
                        <tr @key="($"preview-{ev.EntityId}-{ev.FireAt.Ticks}")">
                            <td class="schedule-time">@ev.FireAt.ToString("HH:mm:ss")</td>
                            <td class="schedule-entity">@ev.EntityId</td>
                            <td class="schedule-state @(ev.State is "on" or "open" ? "state-on" : "state-off")">@ev.State</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

<div class="card">
    <div class="card-header">
        <h2>Today's Active Schedule</h2>
        <button class="btn btn-reschedule" type="button" @onclick="ForceRescheduleAsync" disabled="@_rescheduling">
            @(_rescheduling ? "Rescheduling…" : "🔄 Force Reschedule")
        </button>
    </div>
    @if (!_vacation.Enabled)
    {
        <div class="schedule-empty">Vacation mode is disabled. Use Preview above to simulate it without activating anything.</div>
    }
    else if (_schedule.Count == 0)
    {
        <div class="schedule-empty">No upcoming events queued.</div>
    }
    else
    {
        <div class="schedule-table-wrap">
            <table class="schedule-table">
                <thead><tr><th>Time</th><th>Entity</th><th>Action</th></tr></thead>
                <tbody>
                @foreach (var ev in _schedule)
                {
                    <tr @key="@(ev.EntityId + ev.FireAt.Ticks)">
                        <td class="schedule-time">@ev.FireAt.ToString("HH:mm:ss")</td>
                        <td class="schedule-entity">@ev.EntityId</td>
                        <td class="schedule-state @(ev.State is "on" or "open" ? "state-on" : "state-off")">@ev.State</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="actions">
    <button class="btn btn-save" type="button" @onclick="SaveAsync" disabled="@_saving">
        @(_saving ? "Saving…" : "Save Configuration")
    </button>
</div>

@code {
    private HomeAssistantConfig _ha = new();
    private VacationConfig _vacation = new();
    private string? _newEntityId;
    private string? _newExcludedEntity;
    private string? _newExcludedPattern;
    private string? _successMessage;
    private string? _errorMessage;
    private bool _saving;

    private bool _showPicker;
    private bool _pickerLoading;
    private string? _pickerError;
    private string _pickerFilter = string.Empty;
    private List<HaEntityInfo> _availableEntities = [];

    private List<ScheduledReplay> _schedule = [];
    private List<ScheduledReplay>? _preview;
    private bool _rescheduling;
    private bool _previewLoading;

    private List<HaEntityInfo> FilteredPickerEntities => string.IsNullOrWhiteSpace(_pickerFilter)
        ? _availableEntities
        : _availableEntities.Where(e => e.EntityId.Contains(_pickerFilter.Trim(), StringComparison.OrdinalIgnoreCase)
            || e.FriendlyName.Contains(_pickerFilter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    protected override void OnInitialized()
    {
        _ha = ConfigSvc.GetHomeAssistantConfig();
        _vacation = ConfigSvc.GetVacationConfig();
        RefreshSchedule();
    }

    private void RefreshSchedule() => _schedule = [.. Worker.PeekSchedule()];

    private void UpdateEntity(int index, string value) { if (index >= 0 && index < _vacation.Entities.Count) _vacation.Entities[index] = value; }
    private void RemoveEntity(int index) { if (index >= 0 && index < _vacation.Entities.Count) _vacation.Entities.RemoveAt(index); }
    private void RemoveEntityById(string entityId) => _vacation.Entities.Remove(entityId);

    private void AddEntity()
    {
        var id = _newEntityId?.Trim();
        if (!string.IsNullOrWhiteSpace(id) && !_vacation.Entities.Contains(id, StringComparer.OrdinalIgnoreCase)) _vacation.Entities.Add(id);
        _newEntityId = string.Empty;
    }

    private void AddExcludedEntity()
    {
        var id = _newExcludedEntity?.Trim();
        if (!string.IsNullOrWhiteSpace(id) && !_vacation.ExcludedEntities.Contains(id, StringComparer.OrdinalIgnoreCase)) _vacation.ExcludedEntities.Add(id);
        _newExcludedEntity = string.Empty;
    }

    private void AddExcludedPattern()
    {
        var pattern = _newExcludedPattern?.Trim();
        if (!string.IsNullOrWhiteSpace(pattern) && !_vacation.ExcludedPatterns.Contains(pattern, StringComparer.OrdinalIgnoreCase)) _vacation.ExcludedPatterns.Add(pattern);
        _newExcludedPattern = string.Empty;
    }

    private void OnNewEntityKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddEntity(); }
    private void AddEntityFromPicker(string entityId) { if (!_vacation.Entities.Contains(entityId)) _vacation.Entities.Add(entityId); }

    private async Task TogglePickerAsync()
    {
        if (_showPicker) { ClosePicker(); return; }
        _pickerLoading = true;
        _pickerError = null;
        try
        {
            _availableEntities = await HaClient.GetEntitiesAsync();
            _showPicker = true;
        }
        catch (Exception ex)
        {
            _pickerError = $"Failed to load entities from Home Assistant: {ex.Message}";
            _showPicker = true;
        }
        finally { _pickerLoading = false; }
    }

    private void ClosePicker() { _showPicker = false; _pickerFilter = string.Empty; }

    private async Task PreviewAsync()
    {
        _previewLoading = true;
        _errorMessage = null;
        try { _preview = [.. await Worker.BuildPreviewAsync(_vacation)]; }
        catch (Exception ex) { _errorMessage = $"Failed to build preview: {ex.Message}"; }
        finally { _previewLoading = false; }
    }

    private async Task ForceRescheduleAsync()
    {
        _rescheduling = true;
        try
        {
            var versionBefore = Worker.ScheduleVersion;
            Worker.RequestReschedule();
            var deadline = DateTimeOffset.Now.AddSeconds(15);
            while (Worker.ScheduleVersion == versionBefore && DateTimeOffset.Now < deadline)
                await Task.Delay(TimeSpan.FromMilliseconds(250));
            RefreshSchedule();
        }
        finally { _rescheduling = false; }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _successMessage = null;
        _errorMessage = null;
        try
        {
            await ConfigSvc.SaveAsync(_ha, _vacation);
            Worker.RequestReschedule();
            _successMessage = "Configuration saved and schedule refresh requested.";
        }
        catch (Exception ex) { _errorMessage = $"Failed to save configuration: {ex.Message}"; }
        finally { _saving = false; }
    }
}
